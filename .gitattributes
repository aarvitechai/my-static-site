# Normalise line endings in the repo; check out with the platform-appropriate ending where it matters.
* text=auto

*.cs      text eol=crlf
*.csproj  text eol=crlf
*.slnx    text eol=crlf
*.props   text eol=crlf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

*.png  binary
*.jpg  binary
*.ico  binary
*.db   binary
