<Project>
  <!--
    Central Package Management: every NuGet version is set once, here.
    Projects reference packages WITHOUT a Version attribute, e.g. <PackageReference Include="Serilog.AspNetCore" />.
    This keeps all modules on the same versions and makes upgrades a one-line change.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive packages also get pinned when listed here (used to force patched versions of vulnerable dependencies). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Added as slices need them. -->
    <!-- Phase 1 slice 2: observability, API docs, health -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.7" />
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
  </ItemGroup>
</Project>
