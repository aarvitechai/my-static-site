<Project>
  <!--
    Central Package Management: every NuGet version is set once, here.
    Projects reference packages WITHOUT a Version attribute, e.g. <PackageReference Include="Serilog.AspNetCore" />.
    This keeps all modules on the same versions and makes upgrades a one-line change.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive packages also get pinned when listed here (used to force patched versions of vulnerable dependencies). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Added as slices need them. -->
    <!-- Phase 1 slice 2: observability, API docs, health -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.7" />
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <!-- Phase 1 slice 3: persistence (keep all EF Core / Identity packages on the same patch version) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.14" />
    <!-- Phase 1 slice 4: building blocks -->
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.20" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.15.0" />

    <!-- Security pins for transitive dependencies (CentralPackageTransitivePinningEnabled forces these versions).
         Microsoft.Data.SqlClient brings System.Security.Cryptography.Pkcs 9.0.11, which has known vulnerabilities
         (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). Remove a pin once the parent package ships a fixed version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>
