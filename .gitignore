# Repository-wide ignores. frontend/ and backend/ have their own .gitignore files too.

# Local secrets and environment overrides: never commit
.env
.env.*
!.env.example
*.local
appsettings.*.local.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vs/
.vscode/*
!.vscode/extensions.json

# .NET build output and tooling
[Bb]in/
[Oo]bj/
*.user
*.suo
TestResults/
*.trx
coverage*/

# Logs and temp
*.log
logs/
