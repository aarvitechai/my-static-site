<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables, run by Microsoft.Testing.Platform (opted in via global.json). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\RedStarVibe.BuildingBlocks\RedStarVibe.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\RedStarVibe.BuildingBlocks.Web\RedStarVibe.BuildingBlocks.Web.csproj" />
  </ItemGroup>

</Project>
