<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- TargetFramework, nullable, analyzers etc. come from Directory.Build.props at the repo root. -->

  <PropertyGroup>
    <RootNamespace>RedStarVibe.Api</RootNamespace>
    <!-- Lets `dotnet user-secrets` store local secrets outside the repo (used from slice 3). -->
    <UserSecretsId>redstarvibe-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modules: the host references only each module's Endpoints project. -->
    <ProjectReference Include="..\..\Modules\Identity\RedStarVibe.Modules.Identity.Endpoints\RedStarVibe.Modules.Identity.Endpoints.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions live in Directory.Packages.props (Central Package Management). -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
  </ItemGroup>

</Project>
